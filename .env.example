# Copy to .env (cp .env.example .env). Everything is optional: with no changes the app runs fully offline.

# offline   = deterministic rule-based analyzer + template generator (no network, no key)  [default]
# anthropic = Anthropic Messages API    (needs ANTHROPIC_API_KEY)
# openai    = any OpenAI-compatible chat-completions endpoint (needs OPENAI_API_KEY)
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=30

HOST=127.0.0.1
PORT=8000
